# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments (uv 默认创建 .venv)
.venv/
venv/
env/

# uv
# 注意: uv.lock 应当提交到版本库以保证环境可复现，故不忽略
.uv-cache/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Environment variables / secrets
.env
.env.*
!.env.example

# Logs & local databases
*.log
logs/
*.sqlite3
*.db

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Generated artifacts (regenerated by pipeline scripts)
src/data/outputs/
frontend/.vite/
frontend/.next/
frontend/node_modules/
